{
  "Expiry": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "BatchSize": 100
  },
  "Push": {
    "Enabled": true,
    "IntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
