# Frontend settings. Copy to .env.local for local dev; on Vercel set them in
# Project -> Settings -> Environment Variables. EVERYTHING here ends up in the browser,
# so never put a secret here (the Firebase service-account key belongs ONLY to the API on Render).
#
# Local: http://localhost:5080    Vercel: https://<your-api>.onrender.com
VITE_API_BASE_URL=
# Firebase Console -> Project settings -> General -> Your apps -> Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional Web Push certificate (public). Empty = Firebase default key.
VITE_FIREBASE_VAPID_KEY=
