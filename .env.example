# =====================================================================
#  BadalBooking — TEMPLATE. Copy to .env and fill in:  cp .env.example .env
# =====================================================================
#  - This template IS committed, so it must never contain real secret values.
#  - The API loads it automatically when running in Development (see Infrastructure/DotEnv.cs).
#    Real environment variables always win over values in this file.
#  - Production values do NOT go here. Each section says where they go instead:
#       LOCAL   = this .env file
#       RENDER  = Render dashboard → badal-booking-api → Environment
#       GITHUB  = GitHub repo → Settings → Secrets and variables → Actions
#       VERCEL  = Vercel project → Settings → Environment Variables
#  - Names use "__" (double underscore) = ":" in .NET config,
#    e.g. ConnectionStrings__Default is read as ConnectionStrings:Default.
# =====================================================================


# ---------------------------------------------------------------------
# DATABASE                                   (in use since step 1.2)
# ---------------------------------------------------------------------
# LOCAL : Docker Postgres from compose.yaml (port 5433). Throwaway password.
# RENDER: Supabase "Session pooler" connection string (step 3.2), e.g.
#         Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;
#         Username=postgres.<project-ref>;Password=<supabase-db-password>;SSL Mode=Require;Max Pool Size=10
ConnectionStrings__Default=Host=localhost;Port=5433;Database=badal;Username=postgres;Password=postgres


# ---------------------------------------------------------------------
# JWT — the API's own login tokens            (filled in step 1.3)
# ---------------------------------------------------------------------
# LOCAL : a random key, at least 32 characters (step 1.3 generates it).
# RENDER: a DIFFERENT random key. Never reuse the local one in production.
Jwt__Key=
# Not secret (same value everywhere), kept here so all config is in one place.
Jwt__Issuer=BadalBooking
Jwt__Audience=BadalBooking.Clients


# ---------------------------------------------------------------------
# DEMO PERFORMER ACCOUNT                      (filled in step 1.6)
# ---------------------------------------------------------------------
# Performers can't self-register. The API creates this one account at startup.
# LOCAL : any test email/password.   RENDER: a different strong password.
Seed__PerformerEmail=
Seed__PerformerPassword=


# ---------------------------------------------------------------------
# FIREBASE (Admin SDK)                        (filled in step 2.1)
# ---------------------------------------------------------------------
# From Firebase Console → Project settings.
# LOCAL + RENDER: same Firebase project.
Firebase__ProjectId=
# Firebase Console → Project settings → Service accounts → "Generate new private key".
# Paste the WHOLE JSON on ONE line, wrapped in single quotes: '{"type":"service_account",...}'
# Delete the downloaded .json file afterwards (or keep it outside this folder).
# LOCAL : here.   RENDER: paste the same JSON as an environment variable value.
Firebase__ServiceAccountJson=


# ---------------------------------------------------------------------
# CORS + STATUS PAGE                          (filled in step 3.5)
# ---------------------------------------------------------------------
# Exact browser origin allowed to call the API. Not secret.
# LOCAL : http://localhost:5173 (the Firebase test page).
# RENDER: https://badal-booking-status.vercel.app (the real Vercel URL, nothing else).
Cors__AllowedOrigins__0=
# Id of the demo customer whose last 5 bookings the status page shows. Not secret.
Demo__UserId=


# =====================================================================
#  NOT used by the API — listed only so you know where they go
# =====================================================================
# GITHUB secret  RENDER_DEPLOY_HOOK_URL  (step 3.4)
#   Render → service → Settings → Deploy Hook. Lets GitHub Actions trigger a deploy.
#   Anyone with this URL can redeploy your app, so treat it as a secret.
#
# VERCEL variable  API_BASE_URL  (step 3.5) — not secret
#   e.g. https://badal-booking-api.onrender.com
#
# Firebase WEB config (apiKey, authDomain, appId, VAPID key) — step 2.3
#   Goes in firebase-demo/index.html. These are PUBLIC by design, not secrets.
#   Only the service-account JSON above is private.
